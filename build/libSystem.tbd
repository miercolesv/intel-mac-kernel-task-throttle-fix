    symbols:     [ _printf, _fflush, _strcmp, _strlen, _strtol, _strtod, _memset, _memcpy,
                   ___bzero, _usleep, _exit, _getuid, _signal, _mach_task_self_,
                   dyld_stub_binder ]
...
