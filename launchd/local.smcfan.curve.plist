<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.smcfan.curve</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/smcfan</string>
        <string>curve</string>
        <string>TCMX</string>
        <string>50</string>
        <string>85</string>
        <string>3</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/smcfan.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/smcfan.log</string>
</dict>
</plist>
